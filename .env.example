# CapStore local configuration template.
#   cp .env.example .env   then   docker compose up --build
# Every value below is a placeholder for LOCAL DEVELOPMENT ONLY. Replace secrets with your own random values;
# never reuse them in production and never commit your real .env (it is git-ignored).

# ---- Required secrets (docker compose refuses to start without them) ----
JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789abcdef
MYSQL_ROOT_PASSWORD=local-dev-only-root-password
DB_PASSWORD=local-dev-only-app-password

# ---- Database (MySQL runs inside Compose; the backend connects to the `mysql` service) ----
DB_NAME=capstore
DB_USER=capstore_app
MYSQL_HOST_PORT=3307                 # host port bound to 127.0.0.1, for DB tools on your machine

# ---- Sample data + first admin (local only; seeding never runs in the `prod` profile) ----
APP_SEED_ENABLED=true
ADMIN_EMAIL=admin@capstore.local
ADMIN_PASSWORD=local-dev-only-admin-password

# ---- Store identity ----
STORE_NAME=CapStore
PUBLIC_URL=http://localhost          # the address customers use, e.g. https://www.yourcaps.com

# ---- Payments (Razorpay) ----
# true  = fake payment window for local testing only (NO real money moves)
# false = real Razorpay; fill in the three keys below. Production must use false.
RAZORPAY_DEV_MODE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COURIER_WEBHOOK_SECRET=local-dev-only-courier-webhook-secret

# ---- Shown on GST invoices ----
BUSINESS_NAME=Your Caps Company
BUSINESS_GSTIN=27AAAAA0000A1Z5
BUSINESS_ADDRESS=Your workshop address, City
BUSINESS_STATE=Maharashtra           # decides CGST+SGST (same state) vs IGST
BUSINESS_EMAIL=sales@example.com
BUSINESS_PHONE=+91 90000 00000
CONTACT_EMAIL=support@example.com    # receives contact-form messages

# ---- Email (Mailpit for local development; inbox at http://localhost:8025) ----
MAIL_FROM=no-reply@example.com
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# ---- Image storage (local disk volume by default; `s3` for S3-compatible storage) ----
STORAGE_TYPE=local
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
S3_BUCKET=
AWS_REGION=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=

# ---- Optional build metadata / frontend ----
# IMAGE_TAG=local
# VCS_REF=unknown
# VITE_API_URL=/api/v1
