# ---- Required ----
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters

# ---- Local MySQL (used by the backend container through Docker Desktop) ----
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=capstore
DB_USER=root
DB_PASSWORD=your-local-mysql-password

# ---- Store identity ----
STORE_NAME=CapStore
PUBLIC_URL=http://localhost          # the address customers use, e.g. https://www.yourcaps.com

# ---- Required first admin login: set a unique email and strong password ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Payments (Razorpay) ----
# true  = fake payment window for local testing only (NO real money moves)
# false = real Razorpay. Fill in the three keys below. Production must use false.
# Enable true manually only for local simulation.
RAZORPAY_DEV_MODE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COURIER_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# ---- Shown on GST invoices ----
BUSINESS_NAME=Your Caps Company
BUSINESS_GSTIN=27AAAAA0000A1Z5
BUSINESS_ADDRESS=Your workshop address, City
BUSINESS_STATE=Maharashtra          # decides CGST+SGST (same state) vs IGST
BUSINESS_EMAIL=sales@yourcompany.com
BUSINESS_PHONE=+91 90000 00000
CONTACT_EMAIL=support@yourcompany.com

# ---- Email (Mailpit for local development; inbox at http://localhost:8025) ----
MAIL_FROM=no-reply@yourcompany.com
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
